# Copy this file to `.env.local` and fill in the two values from
# Supabase Dashboard -> Project Settings -> API Keys
#
# NEXT_PUBLIC_SUPABASE_URL is the "Project URL"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is the "publishable" key
#   (older projects call it the "anon public" key; either name works here)
#
# NEXT_PUBLIC_SITE_URL is the public origin of the deployment. It is optional
# locally and required in production: it is used for canonical URLs and social
# preview images. On Railway, set it after generating a domain, for example
# https://scholars-hub-production.up.railway.app

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
